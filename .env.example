# Google Cloud Console > APIs & Services > 認証情報 で発行したOAuthクライアント
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Auth.js (next-auth) のセッション暗号化用シークレット
# 生成コマンド: npx auth secret
AUTH_SECRET=

# 本番環境などデフォルトのURLと異なる場合のみ設定
# AUTH_URL=http://localhost:3000

# Postgres接続文字列（Vercel Postgres / Neonなどで発行）
DATABASE_URL=
